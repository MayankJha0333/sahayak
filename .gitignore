# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem


# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# firebase
functions/node_modules
functions/lib
.firebase/
# emulator logs (firebase-debug, firestore-debug, ui-debug, database-debug, pubsub-debug …)
*-debug.log
*-debug.*.log
# emulator data exports
emulator-data/
.emulator-data/
# Firebase secrets / admin keys — never commit
.runtimeconfig.json
.secret.local
*.secret.local
*firebase-adminsdk*.json
service-account*.json
serviceAccount*.json
credentials.json

# Firebase native config (contains project ids; keep out of public repos)
google-services.json
GoogleService-Info.plist

# local secrets — every .env file (app and functions), except the committed examples
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
# Razorpay key downloads from the dashboard
rzp-key*.csv
*razorpay*key*.csv
_to_delete/
