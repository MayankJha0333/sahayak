RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Razorpay → Settings → Webhooks → secret you typed when adding the webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ── Expert payouts (RazorpayX) ──────────────────────────────
# RazorpayX → Account details → "Account number" of your current account.
# Leave empty on the emulator: payouts are faked with a TESTUTR reference.
RAZORPAYX_ACCOUNT_NUMBER=
# RazorpayX → Settings → Webhooks (payout.processed / payout.reversed / payout.failed).
# Falls back to RAZORPAY_WEBHOOK_SECRET when empty.
RAZORPAYX_WEBHOOK_SECRET=

# ── Aadhaar privacy ─────────────────────────────────────────
# Long random string. Used to fingerprint Aadhaar numbers so the same card
# can't sign up twice. We never store the full number. Set once, never change.
# Make one with:  openssl rand -hex 32
KYC_HASH_SECRET=
