# Copy to .env.local.
# Local: leave VITE_USE_EMULATORS=true and run `npm run firebase:emulators` in the app folder.
VITE_USE_EMULATORS=true

# Live project (Firebase console → Project settings → Web app). Same values as the app's EXPO_PUBLIC_FIREBASE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=asia-south1
