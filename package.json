    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~57.0.19",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "dayjs": "^1.11.23",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "^57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "^57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "^57.0.19",
    "expo-maps": "^57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "^57.0.23",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "^1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "export:web": "expo export --platform web",
    "eas:init": "eas init",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile device --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "update": "eas update --channel preview --environment preview -m \"update\"",
    "eas:env": "node scripts/eas-env.mjs",
    "release": "npm version patch -m \"Release %s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release %s\" && git push --follow-tags",
    "start:dev-client": "expo start --dev-client",
    "native:ios": "expo run:ios",
    "native:android": "expo run:android",
    "firebase:emulators": "npm --prefix functions run build && node scripts/emulators.js",
    "firebase:deploy": "npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes,functions",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "test:customer": "maestro test .maestro/customer",
    "admin:dev": "npm --prefix admin-web run dev",
    "admin:dev:lan": "npm --prefix admin-web run dev -- --host",
    "admin:build": "npm --prefix admin-web run build",
    "admin:deploy": "npm --prefix admin-web run build && npx -y firebase-tools@latest deploy --only hosting"
  },
  "private": true
}
