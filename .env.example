# ---- Firebase (Project settings → Your apps → Web app → SDK config) ----
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth Web client id (Authentication → Google → Web SDK configuration). Android Google Sign-In needs it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Region your functions are deployed in
EXPO_PUBLIC_FUNCTIONS_REGION=asia-south1

# Point the app at local emulators instead of the cloud (true/false)
EXPO_PUBLIC_USE_EMULATORS=false

# ---- Razorpay (public key only; the secret lives in functions/.env) ----
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Only needed for the real Google map on Android
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
